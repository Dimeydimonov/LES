@import url('https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600;1,700&display=swap');

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    height: 100%;
}

body {
    font-family: "Open Sans", Arial, Helvetica, sans-serif;
    padding-top: 50px;
    color: #333;
    background: #ffffff;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}


.nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: #fff;
    border-bottom: 1px solid #e6e6e6;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 4px 0;
    list-style: none;
    gap: 50px;
    text-align: inherit;

}


.header .container {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 10px 0;
}

.banner  {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    padding: 5px;
    text-align: center;
    border-radius: 4px;
}

.banner-info .btn {
    background: #ff6b6b;
    color: #fff;
    padding: 8px 18px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-block;
}
.logo h1 a{
    font-size: 1.3em;
color: #a24b91;
}
.logo span{
    color: #ca0a43;
}
.logo i{
    color: #27ae60;
}

.header-search form {
    display: flex;
    gap: 8px;
    align-items: center;
}
.header-search input[type="search"] {
    padding: 8px 10px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-size: 14px;
    width: 220px;
}
.header-search button {
    padding: 8px 12px;
    border: 0;
    background: #27ae60;
    color: #fff;
    border-radius: 4px;
    cursor: pointer;
}

.button{
    border: 6px solid #27ae60;
    border-radius: 6px;
    font-size: 16px;
    padding: 1px 3px;


}

.lang-switcher a {
    color: #333;
    text-decoration: none;
    margin: 0 3px;
}
.lang-switcher a.active {
    font-weight: bold;
    text-decoration: underline;
}


.content {
    padding: 40px 0;
}

.content .container {
    display: flex;
    gap: 30px;
    align-items: flex-start;
}

.content-left {
    width: 250px;
    flex-shrink: 0;
    margin-left: 3%;
}

.content-left h3 {
    font-size: 16px;
    color: #27ae60;
    margin-bottom: 12px;
    text-transform: uppercase;
}

.content-left .categories {
    list-style: none;
    padding: 0;
    border: 1px solid #eee;
    border-radius: 6px;
    overflow: hidden;
    background: #fafafa;
}

.content-left .categories li {
    padding: 12px 14px;
    border-bottom: 1px solid #f0f0f0;
}

.content-left .categories li a {
    text-decoration: none;
    color: #333;
    font-weight: 700;
    display: block;
}

.content-left .categories li a:hover {
    color: #27ae60;
}

.content-right {
    flex: 1;
}

.special-product {
    background: #fff;
    border: 1px solid #eee;
    padding: 20px;
    border-radius: 6px;
    margin-bottom: 22px;
    display: flex;
}

.special-product-text {

    flex: 1;
    max-width: 250px;
    padding: 20px;
}
.special-product-text h3 {
    font-size: 18px;
    color: #2c3e50;
    margin-bottom: 6px;
}

.special-product-text h3 span {
    color: #ff6b6b;
    font-weight: 900;
    margin-left: 6px;
}

.special-product-text h4 {
    font-size: 22px;
    margin-bottom: 6px;
    color: #444;
    font-weight: 700;
}

.special-product-text p {

    font-size: 15px;
    color: #666;
    margin-bottom: 8px;
}

.special-product-text .btn {
    background: #27ae60;
    color: #fff;
    padding: 8px 16px;
    border-radius: 4px;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
}


.special-product-slider {
    width: 100%;
    height: 280px;
    padding: 20px;
    object-fit: contain;
    border-radius: 4px;
    margin-bottom: 12px;
}

.slider-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
}

.slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s ease-in-out;
}

.slide.active {
    opacity: 1;
}

.slide img {
    padding-top: 5px;
    height: 280px;
    object-fit: contain;
    border-radius: 4px;
    position: relative;
    z-index: 1;
}



.products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 20px;
    margin: 0 auto;
}

.product-card {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 12px;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
     position: relative;
    flex: 1 1 300px;
    max-width: 300px;
}

.product-card img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    border-radius: 4px;
    margin-bottom: 12px;
}

.product-card h4 {
    font-size: 15px;
    color: #2c3e50;
    margin-bottom: 8px;
    font-weight: 700;
}

.product-card p {
    font-size: 15px;
    color: #ff6b6b;
    font-weight: 800;
}

.product-card p span {
    color: #9aa0a6;
    text-decoration: line-through;
    font-weight: 600;
    margin-right: 8px;
}

.product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
}

footer {
    background: #232323;
    color: #cbd5db;
    padding: 40px 0 24px;
    margin-top: 40px;
}

.footer-sections {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.footer-column h3 {
    color: #fff;
    margin-bottom: 10px;
    font-size: 16px;
}

.footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.footer-column ul li {
    margin-bottom: 10px;
}

.footer-column ul li a {
    color: #cbd5db;
    text-decoration: none;
}

.footer-column ul li a:hover {
    color: #fff;
}

.footer-bottom {
    margin-top: 18px;
    text-align: center;
    color: #9aa0a6;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.03);
}

.footer-bottom a {
    color: #27ae60;
    text-decoration: none;
}

.footer-bottom a:hover {
    text-decoration: underline;
}


.text-center {
    text-align: center;
}

.clearfix::after {
    content: '';
    display: block;
    clear: both;
}


@media (max-width: 1100px) {
    .container {
        width: 95%;
    }

    .products {
        flex-wrap: wrap;
        gap: 20px;
    }

    .banner-info h4 {
        font-size: 30px;
    }
}

@media (max-width: 768px) {
    .logo-nav .container,
    .header .container {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .banner {
        padding: 40px 0;
    }

    .content .container {
        flex-direction: column;
        gap: 18px;
    }

    .content-left {
        width: 100%;
        order: 2;
    }

    .content-right {
        order: 1;
        width: 100%;
    }

    .special-product {
        flex-direction: column;
        gap: 20px;
    }

    .special-product-slider {
        width: 100%;
        height: 250px;
    }

    .products {
        flex-wrap: wrap;
        gap: 20px;
    }

    .footer-sections {
        grid-template-columns: repeat(2, 1fr);
    }
}

    .special-product-slider {
        height: 200px;
    }

    .products {
        flex-wrap: wrap;
        gap: 20px;
    }






ul.categories {
    list-style: none;
    padding: 0;
    margin: 0;
}

ul.categories li {
    position: relative;
    padding: 10px;
    cursor: pointer;
    background: #f8f9fa;
    border-bottom: 1px solid #ddd;
}

ul.categories li ul {
    display: none;
    list-style: none;
    padding-left: 15px;
}

ul.categories li:hover > ul {
    display: block;
}

ul.categories li ul li {
    background: #ffffff;
    font-size: 0.9em;
}


.hot_offers {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 40px;
}
.hot_offers .text {
    font-size: 5em;
    font-weight: bold;
    text-transform: uppercase;
    color: #ca0a43;
    text-shadow:10px 10px 10px #764ba2;
}



.pagination {
    display: none;
}

/* Или скрыть только текст */
.pagination .d-none, 
.pagination span:not(.page-link) {
    display: none !important;
}

.product
{
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 40px;
    text-transform: capitalize;
}
.product h2,
.product h3,
.product p {
    max-width: 30%;
    word-wrap: break-word;
    padding: 10px;
}
.product.img {
    max-width: 30%;
}

/* Базовые стили */
body {
    font-family: 'Open Sans', sans-serif;
    font-weight: 400;
}

/* Bootstrap совместимость */
.navbar {
    position: relative;
    min-height: 50px;
    margin-bottom: 0;
    border: none;
}

.navbar-header {
    float: left;
}

.navbar-toggle {
    position: relative;
    float: right;
    padding: 9px 10px;
    margin-top: 8px;
    margin-right: 15px;
    margin-bottom: 8px;
    background-color: transparent;
    background-image: none;
    border: 1px solid transparent;
    border-radius: 4px;
}

.navbar-toggle .icon-bar {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 1px;
    background-color: #888;
}

.navbar-toggle .icon-bar + .icon-bar {
    margin-top: 4px;
}

.collapse {
    display: none;
}

.collapse.in {
    display: block;
}

.nav {
    padding-left: 0;
    margin-bottom: 0;
    list-style: none;
}

.nav > li {
    position: relative;
    display: block;
}

.nav > li > a {
    position: relative;
    display: block;
    padding: 10px 15px;
}

.nav > li > a:hover,
.nav > li > a:focus {
    text-decoration: none;
    background-color: #eee;
}

.navbar-nav {
    margin: 0;
}

.navbar-nav > li > a {
    padding-top: 10px;
    padding-bottom: 10px;
    line-height: 20px;
}

.navbar-nav > li {
    float: none;
}

.caret {
    display: inline-block;
    width: 0;
    height: 0;
    margin-left: 2px;
    vertical-align: middle;
    border-top: 4px dashed;
    border-top: 4px solid \9;
    border-right: 4px solid transparent;
    border-left: 4px solid transparent;
}

.dropdown {
    position: relative;
}

.dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1000;
    display: none;
    float: left;
    min-width: 160px;
    padding: 5px 0;
    margin: 2px 0 0;
    font-size: 14px;
    text-align: left;
    list-style: none;
    background-color: #fff;
    -webkit-background-clip: padding-box;
    background-clip: padding-box;
    border: 1px solid #ccc;
    border: 1px solid rgba(0, 0, 0, .15);
    border-radius: 4px;
    -webkit-box-shadow: 0 6px 12px rgba(0, 0, 0, .175);
    box-shadow: 0 6px 12px rgba(0, 0, 0, .175);
}

.dropdown-menu > li > a {
    display: block;
    padding: 3px 20px;
    clear: both;
    font-weight: normal;
    line-height: 1.42857143;
    color: #333;
    white-space: nowrap;
}

.dropdown-menu > li > a:hover,
.dropdown-menu > li > a:focus {
    color: #262626;
    text-decoration: none;
    background-color: #f5f5f5;
}

.open > .dropdown-menu {
    display: block;
}

/* FlexSlider стили */
.flexslider {
    margin: 0;
    padding: 0;
}

.slides {
    margin: 0;
    padding: 0;
    list-style: none;
}

.slides li {
    display: none;
    margin: 0;
    padding: 0;
}

.flexslider .slides > li {
    display: none;
    -webkit-backface-visibility: hidden;
}

.flexslider .slides img {
    width: 100%;
    display: block;
}

.slides:after {
    content: "\0020";
    display: block;
    clear: both;
    visibility: hidden;
    line-height: 0;
    height: 0;
}

html[xmlns] .slides {
    display: block;
}

* html .slides {
    height: 1%;
}

.no-js .slides > li:first-child {
    display: block;
}

.flexslider {
    background: #fff;
    position: relative;
    zoom: 1;
}

.flex-viewport {
    max-height: 2000px;
    -webkit-transition: all 1s ease;
    -moz-transition: all 1s ease;
    transition: all 1s ease;
}

.loading .flex-viewport {
    max-height: 300px;
}

.flexslider .slides {
    zoom: 1;
}

/* Стили для banner_bottom */
.banner_bottom {
    padding: 0;
}

.wthree_banner_bottom_left_grid_sub {
    padding: 0;
}

.wthree_banner_bottom_left_grid_sub1 {
    padding: 0;
}

.wthree_banner_bottom_left_grid {
    position: relative;
}

.wthree_banner_bottom_left_grid_pos,
.wthree_banner_btm_pos,
.wthree_banner_btm_pos1 {
    position: absolute;
    top: 0%;
    left: 0%;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
}

.wthree_banner_bottom_left_grid_pos h4 {
    color: #fff;
    font-size: 2em;
    font-weight: 600;
}

.wthree_banner_bottom_left_grid_pos h4 span {
    display: block;
    font-size: 1.5em;
    color: #FA1818;
    margin-top: .5em;
}

.wthree_banner_btm_pos h3,
.wthree_banner_btm_pos1 h3 {
    color: #fff;
    font-size: 1.8em;
    font-weight: 600;
}

.wthree_banner_btm_pos h3 span,
.wthree_banner_btm_pos1 h3 span {
    display: block;
    font-size: 1.2em;
    color: #84C639;
    margin: .5em 0;
}

.wthree_banner_btm_pos h3 i {
    font-style: normal;
    color: #FA1818;
}

/* Стили для top-brands */
.top-brands {
    background: #f5f5f5;
    padding: 3em 0;
}

.agile_top_brands_grids {
    margin: 3em 0 0;
}

.top_brand_left {
    padding: 0;
}

/* Стили баннера как в оригинале */
.banner {
    background: url(../images/1.jpg) no-repeat 0px 0px;
    background-size: cover;
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    -ms-background-size: cover;
    min-height: 500px;
}

.w3l_banner_nav_left {
    float: left;
    width: 20%;
    background: #f5f5f5;
}

.w3l_banner_nav_right {
    float: right;
    width: 80%;
}

.w3l_banner_nav_right_banner,
.w3l_banner_nav_right_banner1,
.w3l_banner_nav_right_banner2 {
    min-height: 500px;
    text-align: right;
    padding: 10em 17em 0 0;
    margin-bottom: 5em;
}

.w3l_banner_nav_right_banner {
    background: url(../images/4.jpg) no-repeat 0px 0px;
    background-size: cover;
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    -ms-background-size: cover;
}

.w3l_banner_nav_right_banner1 {
    background: url(../images/5.jpg) no-repeat 0px 0px;
    background-size: cover;
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    -ms-background-size: cover;
}

.w3l_banner_nav_right_banner2 {
    background: url(../images/6.jpg) no-repeat 0px 0px;
    background-size: cover;
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    -ms-background-size: cover;
}

.w3l_banner_nav_right_banner h3,
.w3l_banner_nav_right_banner1 h3,
.w3l_banner_nav_right_banner2 h3 {
    font-size: 2em;
    color: #fff;
    font-weight: 300;
    text-transform: uppercase;
    margin-bottom: 1em;
}

.w3l_banner_nav_right_banner h3 span,
.w3l_banner_nav_right_banner1 h3 span {
    display: block;
    font-weight: 600;
    line-height: 2em;
}

.w3l_banner_nav_right_banner2 h3 i {
    display: block;
    font-weight: 600;
    line-height: 2em;
    color: #FA1818;
    font-style: normal;
}

.more {
    width: 20%;
    text-align: center;
    margin-left: 59em;
}

/* Стили кнопки как в оригинале */
.button--saqui {
    overflow: hidden;
    -webkit-transition: background-color 0.3s ease-in, color 0.3s ease-in;
    transition: background-color 0.3s ease-in, color 0.3s ease-in;
}

.button--saqui.button--inverted {
    background: #fff;
    color: #37474f;
}

.button--saqui::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 9px 30px;
    color: #FFFFFF;
    -webkit-transform-origin: -25% 50%;
    transform-origin: -25% 50%;
    -webkit-transform: rotate3d(0, 0, 1, 45deg);
    transform: rotate3d(0, 0, 1, 45deg);
    -webkit-transition: -webkit-transform 0.3s ease-in;
    transition: transform 0.3s ease-in;
}

.button--saqui.button--inverted::after {
    color: #fff;
}

.button--saqui:hover::after,
.button--saqui:hover {
    -webkit-transition-timing-function: ease-out;
    transition-timing-function: ease-out;
}

.button--saqui:hover {
    background-color: #FA1818;
    color: #656060;
}

.button--saqui.button--inverted:hover {
    background-color: #3f51b5;
    color: #3f51b5;
}

.button--saqui:hover::after {
    -webkit-transform: rotate3d(0, 0, 1, 0deg);
    transform: rotate3d(0, 0, 1, 0deg);
}

.button--round-l {
    border-radius: 40px;
}

.button--text-thick {
    font-weight: 600;
}

.more a {
    padding: 10px 30px;
    background: #84C639;
    font-size: 14px;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    color: #fff;
    position: relative;
    display: block;
}

/* Стили навигации в баннере */
.navbar {
    margin-bottom: 0;
    border: none;
}

.navbar-nav > li {
    float: none;
}

.nav > li > a:hover, .nav > li > a:focus {
    background-color: #84C639;
    color: #fff;
}

.navbar-nav {
    float: none;
    margin: 0;
    border-top: 1px solid #B58F62;
}

.navbar-nav > li > a {
    color: #212121;
    padding: 10px 0px 10px 40px;
    border-bottom: 1px dotted #CDCDCD;
}

.nav .open > a, .nav .open > a:hover, .nav .open > a:focus {
    background-color: #84C639;
    border: none;
}

/* Mega dropdown стили */
.mega-dropdown {
    position: static !important;
}

.mega-dropdown-menu {
    padding: 20px 0px;
    width: 100%;
    box-shadow: none;
    -webkit-box-shadow: none;
    background: #f5f5f5;
    border: none;
    position: static !important;
    display: none;
}

.mega-dropdown.open .mega-dropdown-menu {
    display: block;
}

.mega-dropdown-menu > li > ul {
    padding: 0;
    margin: 0;
}

.mega-dropdown-menu > li > ul > li {
    list-style: none;
}

.mega-dropdown-menu > li > ul > li > a {
    display: block;
    color: #222;
    padding: 3px 5px;
}

.mega-dropdown-menu > li ul > li > a:hover,
.mega-dropdown-menu > li ul > li > a:focus {
    text-decoration: none;
    color: #84C639;
}

.w3ls_vegetables {
    padding: 0 40px;
}

.w3ls_vegetables_menu {
    background: #f5f5f5 !important;
}
.agileits_header {
    background: #212121;
    padding: 1em 0;
}

.w3l_offers {
    float: left;
}

.w3l_offers a {
    font-size: 1.2em;
    color: #fff;
    text-decoration: none;
    padding: .5em 3em;
    background: #84C639;
    display: block;
}

.w3l_search {
    float: left;
    width: 27%;
    margin: .1em 0 0em 10em;
}

.w3l_search input[type="text"] {
    outline: none;
    padding: 10px;
    color: #212121;
    font-size: 14px;
    width: 85%;
    background: #fff;
    border: 1px solid #999;
    float: left;
}

.w3l_search input[type="submit"] {
    outline: none;
    padding: 10px 0 9px;
    width: 15%;
    border: 1px solid;
    position: relative;
    background: url(../images/search.png) no-repeat 14px 5px #FA1818;
}

.w3l_search input[type="submit"]:hover {
    background: url(../images/search.png) no-repeat 14px 5px #84C639;
}

.product_list_header {
    float: left;
    margin-left: 7em;
}

.product_list_header input.button {
    color: #fff;
    font-size: 14px;
    outline: none;
    text-transform: capitalize;
    padding: .5em 2.5em .5em 1em;
    border: 1px solid #84c639;
    margin: .35em 0 0;
    background: #84C639;
}

.w3l_header_right {
    float: left;
    padding-left: 10em;
}

.w3l_header_right ul li {
    list-style-type: none;
}

.w3l_header_right1 {
    float: right;
}

.w3l_header_right1 h2 a {
    font-size: .74em;
    color: #fff;
    padding: .5em 1.5em;
    background: #FA1818;
    display: block;
    text-decoration: none;
}

.dropdown-menu.drp-mnu {
    right: 0;
    min-width: 130px;
    text-align: center;
    padding: 1.5em 0;
    margin: 0;
    left: auto;
}

.dropdown-menu.drp-mnu li:first-child {
    margin-bottom: .5em;
}

.dropdown-menu.drp-mnu li a {
    color: #999;
}

/* Стили логотипа */
.logo_products {
    padding: 4em 0 1em;
}

.w3ls_logo_products_left {
    float: left;
    margin-right: 7em;
}

.w3ls_logo_products_left h1 a {
    font-size: 1.5em;
    color: #212121;
    text-decoration: none;
    text-transform: uppercase;
    display: block;
    background: url(../images/img-sp.png) no-repeat 54px 6px;
    line-height: 1;
    height: 97px;
}

.w3ls_logo_products_left h1 a span {
    font-size: .3em;
    display: block;
    color: #FA1818;
}

.w3ls_logo_products_left1 {
    float: left;
    margin-top: 2.3em;
}

.w3ls_logo_products_left1 ul.phone_email li {
    display: inline-block;
    color: #212121;
    font-family: 'Ubuntu', sans-serif;
    margin-right: 2em;
}

.w3ls_logo_products_left1 ul.phone_email li a {
    color: #212121;
    text-decoration: none;
}

.w3ls_logo_products_left1 ul.special_items li {
    display: inline-block;
}

.w3ls_logo_products_left1 ul.special_items li a {
    color: #212121;
    font-family: 'Ubuntu', sans-serif;
    text-decoration: none;
}

.w3ls_logo_products_left1 ul.special_items li a:hover,
.w3ls_logo_products_left1 ul.phone_email li a:hover {
    color: #FA1818;
}

.w3ls_logo_products_left1 ul.special_items li i {
    padding: 0 2em;
}

.w3ls_logo_products_left1:nth-child(3) {
    margin-left: 6em;
}

/* Стили футера как в оригинале */
.footer {
    background: #212121;
    padding: 5em 0;
}

.w3_footer_grids {
    padding: 0 2em;
}

.w3_footer_grid h3 {
    font-size: 1.5em;
    color: #fff;
    margin-bottom: 1.5em;
    font-family: 'Ubuntu', sans-serif;
}

.w3_footer_grid_list li {
    margin-bottom: 1em;
}

.w3_footer_grid_list li a {
    color: #B5B5B5;
    font-size: 14px;
    text-decoration: none;
    font-family: 'Open Sans', sans-serif;
}

.w3_footer_grid_list li a:hover {
    color: #84C639;
}

.w3_footer_grid_list1 li {
    margin-bottom: 2em;
    color: #B5B5B5;
    font-size: 14px;
    font-family: 'Open Sans', sans-serif;
}

.w3_footer_grid_list1 label {
    margin-right: 1em;
    color: #FA1818;
}

.w3_footer_grid_list1 i {
    display: block;
    margin-bottom: .5em;
}

.w3_footer_grid_list1 span {
    display: block;
    line-height: 1.8em;
}

.w3_footer_grid_list1 span a {
    color: #84C639;
}

.w3_footer_grid_bottom h4 {
    font-size: 1.2em;
    color: #fff;
    margin-bottom: 1em;
    font-family: 'Ubuntu', sans-serif;
}

.w3_footer_grid_bottom h5 {
    font-size: 1.2em;
    color: #fff;
    margin-bottom: 1em;
    font-family: 'Ubuntu', sans-serif;
}

.agileits_social_icons li {
    display: inline-block;
    margin-right: 10px;
}

.agileits_social_icons li a {
    width: 30px;
    height: 30px;
    display: block;
    background: #333;
    border-radius: 50%;
    text-align: center;
    line-height: 30px;
    color: #fff;
}

.agileits_social_icons li a:hover {
    background: #84C639;
}

.wthree_footer_copy {
    text-align: center;
    margin-top: 3em;
}

.wthree_footer_copy p {
    color: #999;
    font-size: 14px;
    font-family: 'Open Sans', sans-serif;
}

.wthree_footer_copy p a {
    color: #84C639;
    text-decoration: none;
}
.custom-pagination {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 20px 0;
}

.custom-pagination a,
.custom-pagination span {
    padding: 8px 12px;
    border: 1px solid #ddd;
    text-decoration: none;
    color: #333;
}

.custom-pagination a:hover {
    background: #ca0a43;
    color: white;
}

.custom-pagination .disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    padding: 20px;
    margin: 0 auto;
}

/* Стили для карточек товаров */
.hover14 {
    margin-bottom: 0;
}

/* Стили карточек товаров как в оригинале */
.agile_top_brand_left_grid {
    background: #FFFFFF;
    padding: .5em;
    border: 1px solid #BEBEBE;
    position: relative;
    margin-bottom: 20px;
}

.agile_top_brand_left_grid:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    transition: all 0.3s ease;
}

.tag {
    position: absolute;
    top: -1%;
    right: 10%;
}

.agile_top_brand_left_grid1 {
    padding: 1em;
    border: 1px solid #D7D7D7;
}

.agile_top_brand_left_grid1 img {
    margin: 0 auto;
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.agile_top_brand_left_grid1 p {
    color: #212121;
    margin: 1.5em 0 1em;
    line-height: 1.5em;
    text-transform: capitalize;
    font-size: 14px;
    font-family: 'Open Sans', sans-serif;
    text-align: center;
}

.agile_top_brand_left_grid1 h4 {
    font-weight: 600;
    font-size: 1em;
    color: #212121;
    font-family: 'Open Sans', sans-serif;
    text-align: center;
    margin: 0.5em 0;
}

.agile_top_brand_left_grid1 h4 span {
    font-weight: 300;
    text-decoration: line-through;
    padding-left: 1em;
}

.snipcart-details {
    text-align: center;
    margin: 1.5em auto 1em;
    width: 77%;
}

.snipcart-details input.button {
    font-size: 14px;
    color: #fff;
    background: #FA1818;
    text-decoration: none;
    position: relative;
    border: none;
    border-radius: 0;
    width: 100%;
    text-transform: uppercase;
    padding: .5em 0;
    outline: none;
    font-family: 'Open Sans', sans-serif;
    font-weight: 600;
    transition: background 0.3s ease;
}

.agile_top_brand_left_grid:hover .snipcart-details input.button,
.snipcart-details input.button:hover {
    background: #84C639;
}

/* Стили заголовков как в оригинале */
.top-brands h3, .fresh-vegetables h3, .mail h3, .testimonials h3, .w3_login h3, .w3ls_w3l_banner_nav_right_grid h3, h3.title, .faq h3, .services h3, .about h3, .team h3, .events h3 {
    text-align: center;
    color: #212121;
    padding-bottom: .5em;
    position: relative;
    font-size: 2.5em;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
}

.top-brands h3:after, .fresh-vegetables h3:after, .mail h3:after, .w3_login h3:after, .testimonials h3:after, .w3ls_w3l_banner_nav_right_grid h3:after, h3.title:after, .faq h3:after, .services h3:after, .about h3:after, .team h3:after, .events h3:after {
    content: '';
    background: #FA1818;
    height: 2px;
    width: 8%;
    position: absolute;
    bottom: 0%;
    left: 46%;
}

.hot_offers .text {
    text-align: center;
    color: #212121;
    padding-bottom: .5em;
    position: relative;
    font-size: 2.5em;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
}

.hot_offers .text:after {
    content: '';
    background: #FA1818;
    height: 2px;
    width: 8%;
    position: absolute;
    bottom: 0%;
    left: 46%;
}
